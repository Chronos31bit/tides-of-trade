{
  "name": "TidesOfTrade",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Packages": {
        "$path": "Packages"
      },
      "Shared": {
        "$path": "src/Shared"
      },
      "TidesClient": {
        "$className": "Folder",
        "Bootstrap": {
          "$path": "src/Client/Bootstrap.lua"
        },
        "Controllers": {
          "$path": "src/Client/Controllers"
        },
        "UI": {
          "$path": "src/Client/UI"
        },
        "AssetIds": {
          "$path": "src/Client/AssetIds.lua"
        }
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/Server"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/Client/Client.client.lua"
        }
      }
    },

    "StarterGui": {
      "$className": "StarterGui",
      "StarterGuiAssets": {
        "$className": "Folder",
        "$path": "src/StarterGuiAssets"
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 64,
        "StreamingTargetRadius": 256,
        "FilteringEnabled": true
      }
    },

    "Lighting": {
      "$className": "Lighting"
    },

    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
